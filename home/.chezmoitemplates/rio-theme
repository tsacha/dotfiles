{{- $palette := includeTemplate "theme-palette" . | fromYaml -}}
{{- $l := index $palette .scheme -}}

[colors]
background = '{{ $l.black1 }}'
foreground = '{{ $l.white }}'
selection-background = '{{ $l.black3 }}'
selection-foreground = '{{ $l.white }}'

cursor = '{{ $l.white }}'

tabs = '{{ $l.black1 }}'
tabs-active = '{{ $l.black2 }}'

black = '{{ $l.black2 }}'
red = '{{ $l.red }}'
green = '{{ $l.green2 }}'
yellow = '{{ $l.yellow }}'
blue = '{{ $l.blue }}'
magenta = '{{ $l.magenta }}'
cyan = '{{ $l.cyan }}'
white = '{{ $l.white }}'

dim-black = '{{ $l.black4 }}'
dim-red = '{{ $l.red }}'
dim-green = '{{ $l.green2 }}'
dim-yellow = '{{ $l.yellow }}'
dim-blue = '{{ $l.blue }}'
dim-magenta = '{{ $l.magenta }}'
dim-cyan = '{{ $l.cyan }}'
dim-white = '{{ $l.white }}'

light-black = '{{ $l.black4 }}'
light-red = '{{ $l.red }}'
light-green = '{{ $l.green2 }}'
light-yellow = '{{ $l.yellow }}'
light-blue = '{{ $l.blue }}'
light-magenta = '{{ $l.magenta }}'
light-cyan = '{{ $l.cyan }}'
light-white = '{{ $l.white }}'
