[init]
	defaultBranch = main

{{ if eq .chezmoi.os "darwin" -}}
[credential]
    helper = osxkeychain
{{ end -}}

 [alias]
    wclone = "!f() { \
        url=$1; \
        folder=$(basename \"$url\" .git); \
        git clone --bare \"$url\" \"$folder/.git\"; \
        cd \"$folder\"; \
        git config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'; \
    }; f"

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[push]
    autoSetupRemote = true

[url "ssh://git@github.com/tsacha"]
	insteadOf = https://github.com/tsacha

[alias]
	staash = stash --all
	bb = !~/.scripts/better-git-branch.sh

[rerere]
	enabled = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[fetch]
	writeCommitGraph = true

[commit]
	gpgsign = true

[merge]
    conflictStyle = zdiff3

{{ if stat (joinPath .chezmoi.homeDir ".gitconfig.work") }}
{{ include (joinPath .chezmoi.homeDir ".gitconfig.work") }}
{{ end }}
