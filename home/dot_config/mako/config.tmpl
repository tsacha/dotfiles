{{ $scheme := includeTemplate "color-scheme" . | trim }}
{{ $palette := includeTemplate "ayu-palette" . | fromYaml }}
{{ $c := index $palette $scheme }}

background-color={{ $c.black2 }}
text-color={{ $c.white }}
border-color={{ $c.black3 }}
progress-color=over {{ $c.green }}

[urgency=high]
border-color={{ $c.red }}
