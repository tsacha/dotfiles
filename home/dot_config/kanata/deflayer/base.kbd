;; Base layer: standard keyboard behavior

(deflayer base
  _    _     _    _
  _    _     _    _    _    _         _    _    _    _    _
  _    q    w    e    r    t         y    u    i    o    p
  _    a    @ss  @dd  @ff  g         h    @jj  @kk  @ll  ;
  _    <    z    x    c    v    bspc n    m    ,    .    /
  _    @lm  @la            _              @ra  @me  _
)

(deflayer base-noop
  •    •     •    •
  •    •     •    •    •    •         •    •    •    •    •
  •    q    w    e    r    t         y    u    i    o    p
  •    a    @ss  @dd  @ff  g         h    @jj  @kk  @ll  ;
  •    <    z    x    c    v    bspc n    m    ,    .    /
  •    @lm  @la            _              @ra  @me  •
)

(deflayer navigation
  _    _    _    _
  _    _    _    _    _    _         _    _    _    _    _
  _    caps home up   end  pgup      grv  7    8    9    0
  _    tab  left down rght pgdn      _    4    5    6    -
  _    _    ins  del  _    _    _    _    1    2    3    =
  _    _    @fn            _              _    @fn  _
)

(deflayer fn
  _    _    _    _
  _    _    _    _    _    _         _    _    _    _    _
  _    _    _    _    _    _         _    f7   f8   f9   f10
  _    _    _    _    _    _         _    f4   f5   f6   f11
  _    _    _    _    _    _    _    _    f1   f2   f3   f12
  _    _    _              _              _    _    _
)

(defalias
  ss (tap-hold $tap_pref $tap_pref s lctrl)
  dd (tap-hold $tap_pref $tap_pref d lmet)
  ff (tap-hold $tap_pref $tap_pref f lalt)

  jj (tap-hold $tap_pref $tap_pref j lalt)
  kk (tap-hold $tap_pref $tap_pref k lmet)
  ll (tap-hold $tap_pref $tap_pref l rctrl)

  lm (tap-hold-press $hold_pref $hold_pref bspc lshift)
  la (tap-hold $tap_pref $tap_pref spc (layer-while-held navigation))
  ra (tap-hold-press $hold_pref $hold_pref ret ralt)
  me (tap-hold $tap_pref $tap_pref esc (layer-while-held navigation))

  fn (tap-hold $tap_pref $tap_pref - (layer-while-held fn))
)
;; vim: set ft=lisp:

