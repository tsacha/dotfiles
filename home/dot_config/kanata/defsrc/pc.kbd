(defsrc
  esc    bspc ret  rshift
  grv    1    2    3    4    5         6    7    8    9    0
  tab    q    w    e    r    t         y    u    i    o    p
  caps   a    s    d    f    g         h    j    k    l    ;
  lshift <    z    x    c    v    b    n    m    ,    .    /
  lctrl  lmet lalt          spc             ralt menu rctrl
)
