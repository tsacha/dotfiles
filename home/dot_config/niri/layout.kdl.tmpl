{{- $scheme := includeTemplate "color-scheme" . | trim -}}
{{- $palette := includeTemplate "rose-pine-palette" . | fromYaml -}}
{{- $c := index $palette $scheme }}
{{- $base := $c.black1 -}}
{{- $subtle := $c.black5 -}}
{{- $accentAlt := $c.cyan -}}
{{- $accent := $c.magenta -}}
layout {
    gaps 4
    center-focused-column "always"

    preset-column-widths {
        proportion 0.5
        proportion 0.66667
        proportion 0.8
    }

    default-column-width { proportion 0.8; }
    focus-ring {
        width 1

        active-color "{{ $accent }}"
        inactive-color "{{ $subtle }}"
    }

    border {
        width 1

        active-color "{{ $accent }}"
        inactive-color "{{ $base }}"
    }
}
