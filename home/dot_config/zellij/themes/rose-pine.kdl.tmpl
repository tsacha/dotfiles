{{- $palette := includeTemplate "rose-pine-palette" . | fromYaml -}}
{{- $l := $palette.light -}}
{{- $d := $palette.dark -}}
themes {
    rose-pine-dawn {
        text_unselected { base "{{ $l.white }}"; background "{{ $l.black0 }}"; emphasis_0 "{{ $l.orange }}"; emphasis_1 "{{ $l.cyan }}"; emphasis_2 "{{ $l.green }}"; emphasis_3 "{{ $l.magenta }}"; }
        text_selected { base "{{ $l.white }}"; background "{{ $l.black2 }}"; emphasis_0 "{{ $l.orange }}"; emphasis_1 "{{ $l.cyan }}"; emphasis_2 "{{ $l.green }}"; emphasis_3 "{{ $l.magenta }}"; }
        ribbon_selected { base "{{ $l.black0 }}"; background "{{ $l.green }}"; emphasis_0 "{{ $l.red }}"; emphasis_1 "{{ $l.orange }}"; emphasis_2 "{{ $l.magenta }}"; emphasis_3 "{{ $l.cyan }}"; }
        ribbon_unselected { base "{{ $l.white }}"; background "{{ $l.black2 }}"; emphasis_0 "{{ $l.orange }}"; emphasis_1 "{{ $l.black0 }}"; emphasis_2 "{{ $l.green }}"; emphasis_3 "{{ $l.magenta }}"; }
        table_title { base "{{ $l.green }}"; background "{{ $l.black2 }}"; emphasis_0 "{{ $l.orange }}"; emphasis_1 "{{ $l.cyan }}"; emphasis_2 "{{ $l.green }}"; emphasis_3 "{{ $l.magenta }}"; }
        table_cell_selected { base "{{ $l.white }}"; background "{{ $l.black2 }}"; emphasis_0 "{{ $l.orange }}"; emphasis_1 "{{ $l.cyan }}"; emphasis_2 "{{ $l.green }}"; emphasis_3 "{{ $l.magenta }}"; }
        table_cell_unselected { base "{{ $l.white }}"; background "{{ $l.black0 }}"; emphasis_0 "{{ $l.orange }}"; emphasis_1 "{{ $l.cyan }}"; emphasis_2 "{{ $l.green }}"; emphasis_3 "{{ $l.magenta }}"; }
        list_selected { base "{{ $l.white }}"; background "{{ $l.black2 }}"; emphasis_0 "{{ $l.red }}"; emphasis_1 "{{ $l.orange }}"; emphasis_2 "{{ $l.cyan }}"; emphasis_3 "{{ $l.magenta }}"; }
        list_unselected { base "{{ $l.white }}"; background "{{ $l.black0 }}"; emphasis_0 "{{ $l.red }}"; emphasis_1 "{{ $l.orange }}"; emphasis_2 "{{ $l.cyan }}"; emphasis_3 "{{ $l.magenta }}"; }
        frame_selected { base "{{ $l.green }}"; background "{{ $l.black0 }}"; emphasis_0 "{{ $l.red }}"; emphasis_1 "{{ $l.orange }}"; emphasis_2 "{{ $l.cyan }}"; emphasis_3 "{{ $l.white }}"; }
        frame_highlight { base "{{ $l.orange }}"; background "{{ $l.black0 }}"; emphasis_0 "{{ $l.red }}"; emphasis_1 "{{ $l.magenta }}"; emphasis_2 "{{ $l.cyan }}"; emphasis_3 "{{ $l.blue }}"; }
        frame_unselected { base "{{ $l.black4 }}"; background 0; emphasis_0 "{{ $l.orange }}"; emphasis_1 "{{ $l.cyan }}"; emphasis_2 "{{ $l.magenta }}"; emphasis_3 0; }
        exit_code_success { base "{{ $l.green }}"; background "{{ $l.black0 }}"; emphasis_0 "{{ $l.cyan }}"; emphasis_1 "{{ $l.black0 }}"; emphasis_2 "{{ $l.magenta }}"; emphasis_3 "{{ $l.blue }}"; }
        exit_code_error { base "{{ $l.red }}"; background "{{ $l.black0 }}"; emphasis_0 "{{ $l.orange }}"; emphasis_1 0 0 0; emphasis_2 0 0 0; emphasis_3 0 0 0; }
        multiplayer_user_colors { player_1 "{{ $l.magenta }}"; player_2 "{{ $l.blue }}"; player_3 "{{ $l.cyan }}"; player_4 "{{ $l.orange }}"; player_5 "{{ $l.green }}"; player_6 "{{ $l.magenta }}"; player_7 "{{ $l.red }}"; player_8 "{{ $l.yellow }}"; player_9 0 0 0; player_10 0 0 0; }
    }
    rose-pine {
        text_unselected { base "{{ $d.white }}"; background "{{ $d.black1 }}"; emphasis_0 "{{ $d.orange }}"; emphasis_1 "{{ $d.cyan }}"; emphasis_2 "{{ $d.green }}"; emphasis_3 "{{ $d.magenta }}"; }
