        list_selected { base "{{ $d.white }}"; background "{{ $d.black3 }}"; emphasis_0 "{{ $d.red }}"; emphasis_1 "{{ $d.orange }}"; emphasis_2 "{{ $d.cyan }}"; emphasis_3 "{{ $d.magenta }}"; }
        list_unselected { base "{{ $d.white }}"; background "{{ $d.black1 }}"; emphasis_0 "{{ $d.red }}"; emphasis_1 "{{ $d.orange }}"; emphasis_2 "{{ $d.cyan }}"; emphasis_3 "{{ $d.magenta }}"; }
        frame_selected { base "{{ $d.green }}"; background "{{ $d.black1 }}"; emphasis_0 "{{ $d.red }}"; emphasis_1 "{{ $d.orange }}"; emphasis_2 "{{ $d.cyan }}"; emphasis_3 "{{ $d.white }}"; }
        frame_highlight { base "{{ $d.orange }}"; background "{{ $d.black1 }}"; emphasis_0 "{{ $d.red }}"; emphasis_1 "{{ $d.magenta }}"; emphasis_2 "{{ $d.cyan }}"; emphasis_3 "{{ $d.blue }}"; }
        frame_unselected { base "{{ $d.black4 }}"; background 0; emphasis_0 "{{ $d.orange }}"; emphasis_1 "{{ $d.cyan }}"; emphasis_2 "{{ $d.magenta }}"; emphasis_3 0; }
        exit_code_success { base "{{ $d.green }}"; background "{{ $d.black1 }}"; emphasis_0 "{{ $d.cyan }}"; emphasis_1 "{{ $d.white }}"; emphasis_2 "{{ $d.magenta }}"; emphasis_3 "{{ $d.blue }}"; }
        exit_code_error { base "{{ $d.red }}"; background "{{ $d.black1 }}"; emphasis_0 "{{ $d.orange }}"; emphasis_1 0 0 0; emphasis_2 0 0 0; emphasis_3 0 0 0; }
        multiplayer_user_colors { player_1 "{{ $d.magenta }}"; player_2 "{{ $d.blue }}"; player_3 "{{ $d.cyan }}"; player_4 "{{ $d.orange }}"; player_5 "{{ $d.green }}"; player_6 "{{ $d.magenta }}"; player_7 "{{ $d.red }}"; player_8 "{{ $d.yellow }}"; player_9 0 0 0; player_10 0 0 0; }
    }
