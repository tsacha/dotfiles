        table_title { base "{{ $d.green }}"; background "{{ $d.black3 }}"; emphasis_0 "{{ $d.orange }}"; emphasis_1 "{{ $d.cyan }}"; emphasis_2 "{{ $d.green }}"; emphasis_3 "{{ $d.magenta }}"; }
