{{ if eq .chezmoi.os "darwin" -}}
window-decoration = true
macos-titlebar-style = transparent
macos-option-as-alt = left
fullscreen = true
{{ else -}}
window-decoration = false
gtk-single-instance = true
{{ end -}}

quit-after-last-window-closed = true
window-theme = system
theme = light:{{ .theme.light.title }},dark:{{ .theme.dark.title }}
unfocused-split-opacity = 1
font-family = GeistMono Nerd Font Mono
font-size = 16
focus-follows-mouse = true
mouse-scroll-multiplier = discrete:1

keybind = alt+shift+h=goto_split:left
keybind = alt+shift+j=goto_split:down
keybind = alt+shift+k=goto_split:up
keybind = alt+shift+l=goto_split:right
keybind = alt+shift+r=next_tab
keybind = alt+shift+n=previous_tab
keybind = alt+shift+t=new_tab
keybind = ctrl+shift+t=new_tab
keybind = alt+shift+,=prompt_tab_title
keybind = alt+shift+m=new_split:right
keybind = alt+shift+p=new_split:down
keybind = ctrl+shift+r=increase_font_size:2
keybind = ctrl+shift+n=decrease_font_size:2

clipboard-read = allow
clipboard-write = allow
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = false
copy-on-select = true

keybind = ctrl+-=ignore
keybind = ctrl++=ignore
keybind = shift+enter=text:\x1b\r
