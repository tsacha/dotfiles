{{- $scheme := includeTemplate "color-scheme" . | trim -}}
{{- $palette := includeTemplate "tomorrow-palette" . | fromYaml -}}
{{- $c := index $palette $scheme -}}

set -g fish_color_normal {{ trimPrefix "#" $c.white }}
set -g fish_color_command {{ trimPrefix "#" $c.orange }}
set -g fish_color_keyword {{ trimPrefix "#" $c.green }}
set -g fish_color_quote {{ trimPrefix "#" $c.cyan }}
set -g fish_color_redirection {{ trimPrefix "#" $c.magenta }}
set -g fish_color_end {{ trimPrefix "#" $c.magenta }}
set -g fish_color_error {{ trimPrefix "#" $c.red }}
set -g fish_color_param {{ trimPrefix "#" $c.blue }}
set -g fish_color_operator {{ trimPrefix "#" $c.black5 }}
set -g fish_color_comment {{ trimPrefix "#" $c.black4 }}

set -g fish_pager_color_description {{ trimPrefix "#" $c.black4 }}
set -g fish_pager_color_selected_prefix {{ trimPrefix "#" $c.black0 }}
set -g fish_pager_color_selected_completion {{ trimPrefix "#" $c.black1 }}
set -g fish_pager_color_selected_description {{ trimPrefix "#" $c.black2 }}
set -g fish_pager_color_selected_background --background={{ trimPrefix "#" $c.white }}

{{- if eq $scheme "light" }}
set -gx FZF_DEFAULT_OPTS "--color=fg:#4d4d4c,bg:#ffffff,hl:#c82829 --color=fg+:#4d4d4c,bg+:#efefef,hl+:#c82829 --color=border:#8959a8,header:#4271ae,gutter:#ffffff --color=spinner:#3e999f,info:#3e999f,separator:#d6d6d6 --color=pointer:#eab700,marker:#718c00,prompt:#eab700"
{{- else }}
set -gx FZF_DEFAULT_OPTS "--color=fg:#c5c8c6,bg:#1d1f21,hl:#cc6666 --color=fg+:#c5c8c6,bg+:#282a2e,hl+:#cc6666 --color=border:#b294bb,header:#81a2be,gutter:#1d1f21 --color=spinner:#8abeb7,info:#8abeb7,separator:#373b41 --color=pointer:#f0c674,marker:#b5bd68,prompt:#f0c674"
{{- end }}
